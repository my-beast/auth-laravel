{
    "name": "mybeast/auth-laravel",
    "description": "Laravel SDK for MyBeast Auth (services.my-beast.com/auth): your people sign in on Auth's hosted pages (OpenID Connect, PKCE), your app keeps its own users and session; plus the users API.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/session": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "MyBeast\\Auth\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MyBeast\\Auth\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["MyBeast\\Auth\\Laravel\\MyBeastAuthServiceProvider"],
            "aliases": { "MyBeastAuth": "MyBeast\\Auth\\Laravel\\Facades\\MyBeastAuth" }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
