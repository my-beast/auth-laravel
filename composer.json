{
    "name": "mybeast/auth-laravel",
    "description": "Laravel SDK for My Beast Auth (services.my-beast.com/auth): your people sign in on Auth's hosted pages (OpenID Connect, PKCE), your app keeps its own users and session; plus the users API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mybeast", "laravel", "auth", "openid-connect", "oidc", "sign-in"],
    "homepage": "https://my-beast.com",
    "support": {
        "issues": "https://github.com/my-beast/auth-laravel/issues",
        "source": "https://github.com/my-beast/auth-laravel"
    },
    "authors": [
        { "name": "My Beast", "homepage": "https://my-beast.com" }
    ],
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/session": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "MyBeast\\Auth\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MyBeast\\Auth\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["MyBeast\\Auth\\Laravel\\MyBeastAuthServiceProvider"],
            "aliases": { "MyBeastAuth": "MyBeast\\Auth\\Laravel\\Facades\\MyBeastAuth" }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
